  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Im Allgemeinen besteht der Millikan Versuch aus einem Plattenkondensator
    mit einer verstellbaren und umpolbaren Spannungsquelle, einem Zerst\xE4uber,
    der feinste \xD6ltr\xF6pfchen (Durchmesser ca.             ) erzeugt und zwischen
    die Kondensatorplatten bef\xF6rdert, und einem Mikroskop zur Beobachtung der
    Tr\xF6pfchenbewegung.\nDie Tr\xF6pfchen m\xFCssen dabei geladen sein, was in
    der Regel bereits beim Zerst\xE4uben in ausreichendem Ma\xDFe durch ihre Reibung
    aneinander und an der Luft geschieht. Um sicherzugehen, verwendet man jedoch
    oft erg\xE4nzend ionisierende Strahlung, die die Tr\xF6pfchen auf ihrem Weg vom
    Zerst\xE4uber in den Plattenkondensator zus\xE4tzlich aufl\xE4dt."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
