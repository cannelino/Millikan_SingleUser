--- !u!114 &783079050
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 783079048}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nHierbei verwenden wir folgende Gr\xF6\xDFen:\r\n\u2022\t  : Radius des
    \xD6ltr\xF6pfchens\r\n\u2022\t  : Dichte des \xD6ls\r\n\u2022\t  : Tr\xF6pfchenladung\r\n\u2022\t 
    : Spannung am Kondensator\r\n\u2022\t  : Plattenabstand des Plattenkondensators\r\n\u2022\t 
    : Dichte der Luft\r\nMit dieser Formel k\xF6nnten wir prinzipiell schon die Tr\xF6pfchenladung
    messen\r\n \t\t\t     .\r\nAllerdings erlaubt das gebeugte Licht des Dunkelfeldmikroskops
    keine sinnvolle Messung des Tr\xF6pfchenradiuses. Dieses Problem l\xF6sen wir,
    indem wir die Spannung abschalten und das resultierende Sinken unseres Tr\xF6pfchens
    beobachten. Nach einer kurzen Beschleunigung bewegt es sich, im Kr\xE4ftegleichgewicht
    von\t\t,           und der der Bewegung entgegenwirkenden Stokesschen Reibungskraft         
    , mit konstanter Geschwindigkeit    \tnach unten\t\t\t\t\t\t\t   .\r\nHier ist    
    die Viskosit\xE4t (\u201EZ\xE4higkeit\u201C) der Luft. Das l\xF6sen wir nach
    dem Radius auf\r\nund setzen das Ergebnis in die Formel f\xFCr die Ladung ein.
    Wir haben jetzt die M\xF6glichkeit,   mittels messbarer Gr\xF6\xDFen zu bestimmen:                         
    .\r\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
