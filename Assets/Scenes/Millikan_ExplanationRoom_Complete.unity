  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<i>Schwebemethode bzw. Einfeldmethode</i>\r\nBei dieser Methode erzeugen
    wir im Plattenkondensator ein E-Feld fester Polung aber variabler St\xE4rke.
    Wir stellen die Spannung so ein, dass einige der Tr\xF6pfchen nach dem Einspr\xFChen
    in der Schwebe bleiben, also ein Kr\xE4ftegleichgewicht herrscht. Dabei wirkt
    die Gewichtskraft         nach unten und die Auftriebskraft        und elektrische
    Kraft          wirken nach oben.\r\n\n<i>Gleichfeldmethode bzw. Zweifeldmethode</i>\nDiese
    Variante des Millikan Versuchs wird auch \u201ESink- und Steigmethode\u201C genannt
    und ist etwas aufwendiger als die Schwebemethode, aber daf\xFCr sind die einzelnen
    Messungen leichter durchzuf\xFChren.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
