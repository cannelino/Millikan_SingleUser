  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Rechnen wir noch eine kurze \xDCbungsaufgabe zum Millikan Versuch durch.\r\nEin
    Tr\xF6pfchen sei in einem Plattenkondensator mit               von der Spannung                 
    in der Schwebe gehalten worden. Nach der Entladung des Kondensators werde die
    konstante Fallgeschwindigkeit                                   gemessen. Zudem
    sei                    ,                     und\n\t\t.\r\nUns interessieren
    die Ladung und die Masse des Tr\xF6pfchens in Einheiten der Elementarladung.
    F\xFCr die Ladung m\xFCssen wir nur die Formel f\xFCr die Schwebemethode verwenden.
    Eingesetzt finden wir\r\n \n\r\n\nUm die Masse zu bestimmen, verwenden wir die
    Formel f\xFCr den Radius aus der Schwebemethode und zus\xE4tzlich             
    \n\t\t    . Damit finden wir\r\n \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
