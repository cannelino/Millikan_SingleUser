  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Zuerst erh\xF6hen wir die eingestellte Spannung aus der Schwebemethode,
    sodass die beobachteten \xD6ltr\xF6pfchen nicht mehr schweben, sondern nach kurzer
    Beschleunigung mit der konstanten Geschwindigkeit      steigen. Die Tr\xF6pfchen
    sind also im Kr\xE4ftegleichgewicht\r\n \t\t\t\t\t\t    ,\r\nwobei die Kr\xE4fte
    links wieder nach unten und die rechts wieder nach oben zeigen.\r\nAnschlie\xDFend
    polen wir den Plattenkondensator bei gleicher Spannung um. Unsere Tr\xF6pfchen
    beschleunigen nach unten und erreichen dann eine konstante Fallgeschwindigkeit           
    . Das Kr\xE4ftegleichgewicht lautet jetzt\r\n \r\nmit Gewichts\u2013 und elektrischer
    Kraft nach unten und Reibungs\u2013 und Auftriebskraft nach oben.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials:
  - {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
