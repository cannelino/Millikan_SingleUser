  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Durch die Messung der Tr\xF6pfchenladung k\xF6nnen wir mit dem Millikan
    Versuch die Elementarladung bestimmen. Dazu m\xFCssen wir den Versuch oft wiederholen
    und die gemessenen Ladungen      vieler Tr\xF6pfchen in ein Diagramm eintragen.
    Dabei ergibt sich, dass die Tr\xF6pfchenladungen nicht kontinuierlich verteilt
    sind, wie man es in der klassischen Physik erwarten w\xFCrde, sondern nur diskrete
    Werte mit immer gleichen Abst\xE4nden zu den n\xE4chsth\xF6heren und -niedrigeren
    einnehmen. Es gibt also eine minimale Ladungseinheit     und jedes Tr\xF6pfchen
    kann nur ganzzahlige Vielfache davon enthalten:        \nmit                ."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
